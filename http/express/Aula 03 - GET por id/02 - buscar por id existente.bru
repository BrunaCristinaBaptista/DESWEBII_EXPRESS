meta {
  name: 02 - Buscar por ID existente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/produtos/1/
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq 1
  res.body.nome: eq "Notebook"
  res.body.preco: eq 3500
}

docs {
GET /api/produtos/1/ — retorna o produto de id 1 (Notebook).
}