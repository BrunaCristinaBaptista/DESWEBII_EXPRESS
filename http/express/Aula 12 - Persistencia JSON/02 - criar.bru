meta {
  name: 02 - Criar e persistir
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/produtos/
  body: none
  auth: none
}

body:json {
  {
    "nome": "Webcam",
    "preco": 199.99
  }
}

assert {
  res.status: eq 201
  res.body.id: eq 6
  res.body.nome: eq "Webcam"
}

docs {
POST grava o novo produto em produtos.json.
}
