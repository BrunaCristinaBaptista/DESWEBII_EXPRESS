meta {
  name: 02 - Criar produto
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/produtos/
  body: none
  auth: none
}

body:json {
  {
    "nome": "Webcam",
    "preco": 199.99
  }
}

assert {
  res.status: eq 201
  res.body.id: eq 6
  res.body.nome: eq "Webcam"
  res.body.preco: eq 199.99
}

docs {
POST /api/produtos/ — cria um produto (201), id incremental 6.
}
