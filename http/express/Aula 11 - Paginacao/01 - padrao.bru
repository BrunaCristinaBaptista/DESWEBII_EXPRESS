meta {
  name: 01 - Paginação padrão
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/produtos/
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.page: eq 1
  res.body.page_size: eq 10
  res.body.total_pages: eq 1
  res.body.results.length: eq 5
}

docs {
Resposta paginada: { page, page_size, total_pages, results }.
}
