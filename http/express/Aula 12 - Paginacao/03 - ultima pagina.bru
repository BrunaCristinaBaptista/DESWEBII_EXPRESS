meta {
  name: 03 - Última página parcial
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/produtos/?page=9&page_size=7
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.page: eq 9
  res.body.page_size: eq 7
  res.body.total_pages: eq 9
  res.body.results.length: eq 4
}

docs {
Última página parcial com page_size=7: 8 páginas completas + 4 itens restantes (60 = 7×8 + 4).
}