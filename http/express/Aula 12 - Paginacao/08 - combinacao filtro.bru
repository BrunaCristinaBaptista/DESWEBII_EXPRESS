meta {
  name: 08 - Paginação + filtro (preco_minimo=100)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/produtos/?preco_minimo=100&page_size=10
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.page: eq 1
  res.body.total_pages: eq 4
  res.body.results.length: eq 10
}

docs {
Paginação combinada com filtro: 38 produtos com preço >= 100 → 4 páginas de 10.
}