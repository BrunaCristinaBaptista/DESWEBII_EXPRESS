meta {
  name: 02 - page=2&page_size=2
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/produtos/?page=2&page_size=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.page: eq 2
  res.body.page_size: eq 2
  res.body.total_pages: eq 30
  res.body.results.length: eq 2
}

docs {
Segunda página com 2 itens (total de 30 páginas para 60 produtos).
}