meta {
  name: 04 - page além do limite
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/produtos/?page=31&page_size=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.page: eq 31
  res.body.total_pages: eq 30
  res.body.results.length: eq 0
}

docs {
Página além do fim (page 31 > 30) → results vazio (200).
}